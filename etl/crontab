# Planning de l'ETL (format cron : minute heure jour mois jour-de-semaine commande)
# Le script s'exécute depuis /app ; l'heure est celle du conteneur (UTC par défaut).
#
# Toutes les heures à la minute 0 ; ignoré tant que etl/main.py n'existe pas.
0 * * * * [ -f etl/main.py ] && python -m etl.main || echo "etl/main.py absent : ETL pas encore initialisé"
