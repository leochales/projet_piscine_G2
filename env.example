# Copier ce fichier en .env et remplacer les valeurs.
# Ne jamais commiter le fichier .env.

# PostgreSQL
POSTGRES_USER=enervision
POSTGRES_PASSWORD=changeme
POSTGRES_DB=enervision
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Comptes PostgreSQL des services (droits : db/06_roles.sql).
# En déploiement, ces valeurs viennent des secrets GitHub du même nom.
ETL_DB_PASSWORD=changeme
MODEL_DB_PASSWORD=changeme
API_DB_PASSWORD=changeme
BACKUP_DB_PASSWORD=changeme

# pgAdmin (http://localhost:5050) — l'email doit avoir un format valide
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme
PGADMIN_PORT=5050

# ETL (cron + script Python) : mettre false pour le désactiver
ETL_ENABLED=true

# Traefik : point d'entrée unique (http://localhost) et tableau de bord
HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# API métier (servie par Traefik sur http://localhost/api)
# Origines autorisées par CORS (liste JSON), utile quand le front tourne hors de Traefik
API_CORS_ORIGINS=["http://localhost:5173"]

# Service de prédiction
MODEL_PORT=8001
MODEL_SERVICE_URL=http://model:8001

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Front
FRONT_PORT=5173
# Sélecteur de rôle de démo (en attendant Keycloak) : toujours actif en dev, false en prod
VITE_DEMO_ROLES=false
# Front (servi par Traefik sur http://localhost)
# Chemin relatif : le front et l'API partagent la même origine derrière Traefik
VITE_API_URL=/api
