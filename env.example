# PostgreSQL
POSTGRES_USER=enervision
POSTGRES_PASSWORD=changeme
POSTGRES_DB=enervision
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Comptes PostgreSQL des services (droits : db/06_roles.sql).
# En déploiement, ces valeurs viennent des secrets GitHub du même nom.
ETL_DB_PASSWORD=changeme
MODEL_DB_PASSWORD=changeme
API_DB_PASSWORD=changeme
BACKUP_DB_PASSWORD=changeme
# Compte de supervision (rôle pg_monitor, lu par postgres-exporter). Facultatif :
# sans lui, le compte existe mais ne peut pas se connecter.
MONITORING_DB_PASSWORD=changeme

# Keycloak (http://localhost/auth via Traefik, console : http://localhost/auth/admin, realm enervision)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_DB_PASSWORD=changeme
KEYCLOAK_ADMIN_CLIENT_SECRET=changeme
# Adresses du front acceptées en retour de connexion (lues au premier import du realm).
# En déploiement, FRONT_URL est calculée par deploy.yml à partir de VM_IP.
FRONT_URL=http://localhost
FRONT_DEV_URL=http://localhost:5173

# pgAdmin (http://localhost:5050) — l'email doit avoir un format valide
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme
PGADMIN_PORT=5050

# ETL (cron + script Python) : mettre false pour le désactiver
ETL_ENABLED=true

# Traefik : point d'entrée unique (http://localhost) et tableau de bord
HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# API métier (servie par Traefik sur http://localhost/api)
# Origines autorisées par CORS (liste JSON), utile quand le front tourne hors de Traefik
API_CORS_ORIGINS=["http://localhost:5173"]
# Prix de l'électricité en € HT par kWh, utilisé pour convertir les consommations en euros.
# Tarif fixe provisoire, en attente du tarif officiel du formateur
PRIX_KWH_EUR=0.14

# Niveau des logs JSON de l'API (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Supervision (profil monitoring) : Grafana sur http://localhost/grafana, compte admin
GRAFANA_ADMIN_PASSWORD=changeme

# Service de prédiction
MODEL_PORT=8001
MODEL_SERVICE_URL=http://model:8001

# MLflow (http://localhost/mlflow via Traefik)
# L'URI inclut /mlflow car le serveur tourne avec --static-prefix /mlflow
# → toute l'API MLflow (y compris entre conteneurs) passe sous /mlflow.
MLFLOW_TRACKING_URI=http://mlflow:5000/mlflow

# Jeu d'entraînement du modèle (python -m model.dataset), dossiers ignorés par Git
DATASET_RAW_DIR=data/raw
DATASET_OUTPUT_DIR=data/processed

# Front
FRONT_PORT=5173
# Front (servi par Traefik sur http://localhost)
# Chemin relatif : le front et l'API partagent la même origine derrière Traefik
VITE_API_URL=/api
