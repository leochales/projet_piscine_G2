{
  "realm": "enervision",
  "displayName": "EnerVision",
  "loginTheme": "enervision",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr"],
  "defaultLocale": "fr",
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "eventsListeners": ["jboss-logging"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "attributes": {
    "adminEventsExpiration": "7776000"
  },
  "roles": {
    "realm": [
      {
        "name": "CONSULT-SITE",
        "description": "Consulter les sites"
      },
      {
        "name": "CONSULT-CLIENT",
        "description": "Consulter les clients"
      },
      {
        "name": "GESTION-SITE",
        "description": "Gérer les sites"
      },
      {
        "name": "GESTION-CLIENT",
        "description": "Gérer les clients"
      },
      {
        "name": "MONITORING",
        "description": "Accéder au monitoring"
      }
    ]
  },
  "clients": [
    {
      "clientId": "enervision-front",
      "name": "Dashboard EnerVision",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${FRONT_URL}/*", "${FRONT_DEV_URL}/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience-enervision-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "enervision-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "enervision-api",
      "name": "API EnerVision",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "enervision-admin",
      "name": "Administration des comptes (API EnerVision)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-enervision-admin",
      "enabled": true,
      "serviceAccountClientId": "enervision-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    }
  ]
}
